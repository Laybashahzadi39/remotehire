generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(SEEKER)
  trusted       Boolean        @default(false)
  blocked       Boolean        @default(false)
  emailVerified DateTime?
  jobs          Job[]
  applications  Application[]
  reports       Report[]
  profile       Profile?
  emailTokens   EmailToken[]
  notifications Notification[]
}

model Job {
  id           String        @id @default(cuid())
  title        String
  company      String
  location     String
  workMode     WorkMode      @default(REMOTE)
  jobType      JobType       @default(FULL_TIME)
  salary       String?
  description  String
  status       JobStatus     @default(PENDING)
  employer     User          @relation(fields: [employerId], references: [id])
  employerId   String
  applications Application[]
  reports      Report[]
  createdAt    DateTime      @default(now())
  expiresAt    DateTime?
}

model Application {
  id        String    @id @default(cuid())
  status    AppStatus @default(PENDING)
  coverNote String?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id])
  jobId     String
  seeker    User      @relation(fields: [seekerId], references: [id])
  seekerId  String

  @@unique([jobId, seekerId])
}

model Profile {
  id         String  @id @default(cuid())
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  @unique
  headline   String?
  location   String?
  skills     String?
  summary    String?
  resumeName String?
  resumeData Bytes?
}

model Report {
  id         String       @id @default(cuid())
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  createdAt  DateTime     @default(now())

  @@unique([jobId, reporterId])
}

model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model EmailToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      TokenType
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  message   String
  link      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
enum Role {
  SEEKER
  EMPLOYER
  ADMIN
}

enum JobStatus {
  PENDING
  LIVE
  CLOSED
  REJECTED
  HIDDEN
}

enum AppStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ReportReason {
  ASKS_FOR_MONEY
  FAKE_COMPANY
  MISLEADING
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}
