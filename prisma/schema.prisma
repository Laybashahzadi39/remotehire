generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"    // client yahan generate hoga
}

datasource db {
  provider = "postgresql"             // url yahan NAHI likhna
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String                       // bcrypt se hashed
  role         Role          @default(SEEKER)
  jobs         Job[]
  applications Application[]
  trusted      Boolean       @default(false) 
  blocked      Boolean       @default(false)
  reports      Report[]
  profile      Profile?
}

model Job {
  id           String        @id @default(cuid())
  title        String
  company      String
  location     String                       // "Remote" ya city
  salary       String?
  description  String
  status       JobStatus     @default(PENDING)   // admin approve karega
  workMode     WorkMode  @default(REMOTE)
  jobType      JobType   @default(FULL_TIME)
  employer     User          @relation(fields: [employerId], references: [id])
  employerId   String
  applications Application[]
  reports      Report[]
  createdAt    DateTime      @default(now())
}

model Application {
  id        String    @id @default(cuid())
  status    AppStatus @default(PENDING)
  job       Job       @relation(fields: [jobId], references: [id])
  jobId     String
  seeker    User      @relation(fields: [seekerId], references: [id])
  coverNote String?
  createdAt DateTime @default(now())
  seekerId  String
  @@unique([jobId, seekerId])               // ek job par ek hi baar apply
}
model Profile {
  id         String  @id @default(cuid())
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  @unique
  headline   String?
  location   String?
  skills     String?   // comma separated: "React, Node, SQL"
  summary    String?
  resumeName String?
  resumeData Bytes?    // PDF ke bytes (private)
}

enum Role {
  SEEKER
  EMPLOYER
  ADMIN
}

enum JobStatus {
  PENDING
  LIVE
  CLOSED
  REJECTED
  HIDDEN
}
enum AppStatus {
  PENDING
  REVIEWED
  INTERVIEW
  REJECTED
}
enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}
model Report {
  id         String       @id @default(cuid())
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  job        Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  createdAt  DateTime     @default(now())

  @@unique([jobId, reporterId])   // ek user ek job ko ek hi baar report kare
}

enum ReportReason {
  ASKS_FOR_MONEY
  FAKE_COMPANY
  MISLEADING
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}